rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function roomPath(code) { return /databases/$(database)/documents/rooms/$(code); }
    function isMember(code) {
      return signedIn() &&
        exists(/databases/$(database)/documents/rooms/$(code)/members/$(request.auth.uid));
    }
    function isHost(code) {
      return signedIn() && get(roomPath(code)).data.hostId == request.auth.uid;
    }

    // Private profile extras (phone etc.)
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'phone', 'updatedAt'])
        && (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 24);
    }

    match /rooms/{code} {
      // A room can only be fetched by its exact code. Nobody can list rooms.
      allow get: if signedIn() && code.matches('^[0-9A-F]{8}$');
      allow list: if false;

      allow create: if signedIn() && code.matches('^[0-9A-F]{8}$')
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.kicked.size() == 0;

      // Only the host edits the room (kick list); hostId can never change.
      allow update: if signedIn() && resource.data.hostId == request.auth.uid
        && request.resource.data.hostId == resource.data.hostId;
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || isMember(code));
        allow create, update: if signedIn() && request.auth.uid == uid
          && !(uid in get(roomPath(code)).data.kicked)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 60;
        allow delete: if signedIn() && (request.auth.uid == uid || isHost(code));
      }

      match /messages/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'photoURL', 'text', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.createdAt == request.time;
        allow delete: if isHost(code);
      }

      match /reactions/{id} {
        allow read: if isMember(code);
        allow create: if isMember(code)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.emoji is string
          && request.resource.data.emoji.size() <= 8
          && request.resource.data.createdAt == request.time;
        allow delete: if isHost(code);
      }

      // Playback state: one doc, any member may drive it.
      match /meta/{doc} {
        allow read: if isMember(code);
        allow create, update: if isMember(code) && doc == 'playback'
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time
          && request.resource.data.state in ['playing', 'paused']
          && request.resource.data.position is number
          && request.resource.data.position >= 0
          && (request.resource.data.videoId == null
              || (request.resource.data.videoId is string && request.resource.data.videoId.size() == 11));
        allow delete: if isHost(code);
      }
    }
  }
}
